# Copy to .env.local and fill in. Never commit .env.local.

# ── Database ─────────────────────────────────────────────
# Local (default): SQLite file, created by `npx prisma migrate dev`
DATABASE_URL="file:./db/oretha.db"

# Production (Turso): create a DB at https://turso.tech then:
# DATABASE_URL="libsql://your-db-yourorg.turso.io"
# DATABASE_AUTH_TOKEN="your-long-lived-token"

# ── Auth ─────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="generate-a-long-random-string-here"

# ── LLM (Oretha's voice) ─────────────────────────────────
# Any OpenAI-compatible API works (OpenAI, Groq, Together, OpenRouter,
# Ollama…). Set ANTHROPIC for Claude via LLM_PROVIDER.
LLM_PROVIDER="openai"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
# Optional override (e.g. https://api.groq.com/openai/v1 or http://localhost:11434/v1)
# LLM_BASE_URL=""
