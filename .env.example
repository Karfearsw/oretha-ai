# Copy to .env.local and fill in. Never commit .env.local.

# ── Database ─────────────────────────────────────────────
# Local (default): SQLite file, created by `npx prisma migrate dev`
DATABASE_URL="file:./db/oretha.db"

# Production (Turso): create a DB at https://turso.tech then:
# DATABASE_URL="libsql://your-db-yourorg.turso.io"
# DATABASE_AUTH_TOKEN="your-long-lived-token"

# ── Auth ─────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="generate-a-long-random-string-here"

# ── LLM (Oretha's voice) ─────────────────────────────────
# Providers: openai (default, any OpenAI-compatible API), anthropic, meta.
#
# Meta Model API (Muse Spark) — the default main agent:
#   LLM_PROVIDER="meta"   LLM_MODEL="muse-spark-1.3"
#   LLM_API_KEY="LLM|team-id|key"   ← create at https://dev.meta.ai
#   (base URL defaults to https://api.meta.ai/v1)
#
# FREE-PROVIDER CHEAT SHEET (all OpenAI-compatible; copy one block):
# ── Groq — fastest free tier (Llama 3.3 70B, ~320 tok/s, 1k req/day,
#    no training on your data): https://console.groq.com/keys
# LLM_PROVIDER="openai"
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_MODEL="llama-3.3-70b-versatile"
#
# ── Cerebras — big free throughput (~1M tokens/day, Llama 3.3 70B,
#    no training): https://cloud.cerebras.ai
# LLM_PROVIDER="openai"
# LLM_BASE_URL="https://api.cerebras.ai/v1"
# LLM_MODEL="llama-3.3-70b"
#
# ── OpenRouter — one key, 20+ free models, 50 req/day free:
#    https://openrouter.ai/keys
# LLM_PROVIDER="openai"
# LLM_BASE_URL="https://openrouter.ai/api/v1"
# LLM_MODEL="meta-llama/llama-3.3-70b-instruct:free"
#
# ── Mistral — ~1B tokens/month Experiment tier (requires opting in to
#    data training): https://console.mistral.ai
# LLM_PROVIDER="openai"
# LLM_BASE_URL="https://api.mistral.ai/v1"
# LLM_MODEL="mistral-small-latest"
#
# ── GitHub Models — GPT-4o / Claude / Llama with a GitHub token,
#    150–1,000 req/day: https://github.com/marketplace/models
# LLM_PROVIDER="openai"
# LLM_BASE_URL="https://models.github.ai/inference"
# LLM_MODEL="openai/gpt-4o"
#
# ── Local Ollama — unlimited, private, your hardware:
# LLM_PROVIDER="openai"
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_MODEL="llama3.3"

LLM_PROVIDER="meta"
LLM_API_KEY=""
LLM_MODEL="muse-spark-1.3"
# Optional override (set by the cheat-sheet block you copy above)
# LLM_BASE_URL=""

# ── Secondary providers (automatic failover) ─────────────
# When the primary fails BEFORE the first streamed token (rate limit,
# outage, bad key, 15s connect timeout), the app retries the next
# provider in this list, in order. Format per entry:
#   provider::apiKey[::model][::baseUrl]     entries separated by ";"
# Example — Meta primary, Groq secondary, OpenRouter safety net:
# LLM_FALLBACKS="groq::gsk_yourkey::llama-3.3-70b-versatile;openrouter::sk-or-yourkey::meta-llama/llama-3.3-70b-instruct:free"
LLM_FALLBACKS=""

# ── Mailroom (AgentMail — her own inbox) ─────────────────
# Users paste their own am_… key at setup or in KEVO Office → Inbox.
# Keys are stored AES-256-GCM-encrypted; no server env key needed.
# Override only for local testing against scripts/mock-agentmail.mjs:
# AGENTMAIL_BASE_URL="http://localhost:4100"
