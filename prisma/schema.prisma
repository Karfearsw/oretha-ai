generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  tagline        String?
  plan           String   @default("free")
  avatarSeed     String   @default("T")

  // agent setup
  setupCompleted Boolean  @default(false)
  agentName      String   @default("Oretha")
  agentEmoji     String   @default("")
  voice          String?
  timezone       String?
  censorship     String   @default("open")
  empowerment    Boolean  @default(true)
  responseLength String   @default("balanced")

  // bring-your-own-key LLM settings (encrypted at rest, AES-256-GCM)
  llmProvider     String?
  llmApiKeyEnc    String?
  llmModel        String?
  llmBaseUrl      String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts   Account[]
  threads    Thread[]
  agentFiles AgentFile[]
  mailboxes  Mailbox[]
  tasks      Task[]
  workflows  Workflow[]
  connectors Connector[]
}

model AgentFile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Account {
  id                  String   @id @default(cuid())
  userId              String
  provider            String
  providerAccountId   String
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Thread {
  id        String   @id @default(cuid())
  userId    String
  slug      String   @default("t1")
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([userId, slug])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  role      String
  content   String
  createdAt DateTime @default(now())
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

/* ── KEVO mailroom: agent-owned inboxes (AgentMail) ────────────────── */

model Mailbox {
  id           String    @id @default(cuid())
  userId       String
  provider     String    @default("agentmail")
  apiKeyCipher String
  iv           String
  authTag      String
  inboxId      String
  address      String
  displayName  String?
  verified     Boolean   @default(false)
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails       EmailMessage[]

  @@unique([userId, inboxId])
}

model EmailMessage {
  id         String    @id @default(cuid())
  mailboxId  String
  remoteId   String
  fromAddr   String
  subject    String
  preview    String    @default("")
  receivedAt DateTime
  triaged    Boolean   @default(false)
  action     String?
  taskTitle  String?
  mailbox    Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  task       Task?

  @@unique([mailboxId, remoteId])
}

/* Task board rows — surfaced from email triage, chat, or manual entry. */

model Task {
  id         String        @id @default(cuid())
  userId     String
  title      String
  source     String        @default("Manual")
  lane       String        @default("In Progress")
  assigneeId String        @default("oretha")
  priority   String        @default("med")
  due        String?
  emailId    String?       @unique
  remoteKey  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      EmailMessage? @relation(fields: [emailId], references: [id])

  @@unique([userId, remoteKey])
}

/* ── Workflows: scheduled automations (run by the sweep) ───────────── */

model Workflow {
  id        String        @id @default(cuid())
  userId    String
  name      String
  action    String        @default("mail_triage")
  prompt    String?
  schedule  String        @default("daily")
  enabled   Boolean       @default(true)
  lastRunAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs      WorkflowRun[]
}

model WorkflowRun {
  id         String   @id @default(cuid())
  workflowId String
  status     String   @default("running")
  summary    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
}

/* ── Connectors: user-linked external services (GitHub, Linear, …) ────
 * Tokens are AES-256-GCM-encrypted at rest (same scheme as mailbox and
 * BYOK-LLM keys). One row per user per service kind. */

model Connector {
  id           String    @id @default(cuid())
  userId       String
  kind         String
  tokenCipher  String
  iv           String
  authTag      String
  meta         String    @default("{}")
  lastSyncAt   DateTime?
  lastSyncInfo String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}
