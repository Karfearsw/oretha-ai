generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  tagline        String?
  plan           String   @default("free")
  avatarSeed     String   @default("T")

  // agent setup
  setupCompleted Boolean  @default(false)
  agentName      String   @default("Oretha")
  agentEmoji     String   @default("")
  voice          String?
  timezone       String?
  censorship     String   @default("open")
  empowerment    Boolean  @default(true)
  responseLength String   @default("balanced")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts  Account[]
  threads   Thread[]
  agentFiles AgentFile[]
}

model AgentFile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Account {
  id                  String   @id @default(cuid())
  userId              String
  provider            String
  providerAccountId   String
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Thread {
  id        String   @id @default(cuid())
  userId    String
  slug      String   @default("t1")
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([userId, slug])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  role      String
  content   String
  createdAt DateTime @default(now())
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
}
